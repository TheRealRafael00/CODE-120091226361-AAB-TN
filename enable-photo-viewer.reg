Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\Applications\photoviewer.dll\shell\open]
"MuiVerb"="@photoviewer.dll,-3043"

[HKEY_CURRENT_USER\Software\Classes\Applications\photoviewer.dll\shell\open\command]
@="\"%SystemRoot%\\System32\\rundll32.exe\" \"%ProgramFiles%\\Windows Photo Viewer\\PhotoViewer.dll\", ImageView_Fullscreen %1"

[HKEY_CURRENT_USER\Software\Classes\PhotoViewer.FileAssoc.Jpeg]
"EditFlags"=dword:00000001

[HKEY_CURRENT_USER\Software\Classes\PhotoViewer.FileAssoc.Jpeg\shell\open\command]
@="\"%SystemRoot%\\System32\\rundll32.exe\" \"%ProgramFiles%\\Windows Photo Viewer\\PhotoViewer.dll\", ImageView_Fullscreen %1"

[HKEY_CURRENT_USER\Software\Classes\PhotoViewer.FileAssoc.Jpeg\shell\open]
"MuiVerb"="@photoviewer.dll,-3043"

[HKEY_CURRENT_USER\Software\Classes\.jpg\OpenWithProgids]
"PhotoViewer.FileAssoc.Jpeg"=""

[HKEY_CURRENT_USER\Software\Classes\.jpeg\OpenWithProgids]
"PhotoViewer.FileAssoc.Jpeg"=""
